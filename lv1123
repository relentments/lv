local function updateFarmUI()
    LeftBtn.BackgroundColor3 = (FarmActive == "Left") and Color3.fromRGB(35, 100, 35) or Color3.fromRGB(35, 35, 35)
    RightBtn.BackgroundColor3 = (FarmActive == "Right") and Color3.fromRGB(35, 100, 35) or Color3.fromRGB(35, 35, 35)
end

LeftBtn.MouseButton1Click:Connect(function() 
    if FarmActive == "Left" then FarmActive = nil else FarmActive = "Left" end
    updateFarmUI() 
end)

RightBtn.MouseButton1Click:Connect(function()
    if FarmActive == "Right" then 
        FarmActive = nil 
    else
        FarmActive = "Right"
        task.spawn(function()
            while FarmActive == "Right" do
                local hrp = getHRP()
                if hrp then hrp.CFrame = CFrame.new(Locations["Right"]) end
                task.wait(1) 
                if FarmActive ~= "Right" then break end
                local hum = getHum()
                if hum then hum.Health = 0 end
                Player.CharacterAdded:Wait()
                task.wait(0.5) 
            end
        end)
    end
    updateFarmUI()
end)

