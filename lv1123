-- Dash Application Logic
local function applyDash(directionVector)
    local hrp = getHRP()
    if not hrp or not GlideActive then return end
    hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + (directionVector * DASH_POWER)
end

-- Directional Helper
local function getDirectionFromKeys()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
    local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z).Unit
    local finalDir = Vector3.new(0,0,0)

    if UIS:IsKeyDown(Enum.KeyCode.W) then finalDir = finalDir + look end
    if UIS:IsKeyDown(Enum.KeyCode.S) then finalDir = finalDir - look end
    if UIS:IsKeyDown(Enum.KeyCode.A) then finalDir = finalDir - right end
    if UIS:IsKeyDown(Enum.KeyCode.D) then finalDir = finalDir + right end

    if finalDir.Magnitude > 0 then
        return finalDir.Unit
    else
        return nil
    end
end

-- Reach Cleanup
local function resetHitboxes()
    for _, otherPlayer in pairs(game.Players:GetPlayers()) do
        if otherPlayer.Character then
            local hrp = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Shape = Enum.PartType.Block
                hrp.Transparency = 1
                hrp.Material = Enum.Material.Plastic
            end
        end
    end
end

-- Headless Logic
local function toggleHeadless(state)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local head = char:WaitForChild("Head", 5)
    if not head then return end
    
    local headMesh = head:FindFirstChildOfClass("SpecialMesh")
    local face = head:FindFirstChildOfClass("Decal")

    if state == true then
        head.Transparency = 1
        if face then face.Transparency = 1 end
        if headMesh then 
            if headMesh.Scale ~= Vector3.new(0,0,0) then
                originalScale = headMesh.Scale 
            end
            headMesh.Scale = Vector3.new(0,0,0) 
        end
    else
        head.Transparency = 0
        if face then face.Transparency = 0 end
        if headMesh then headMesh.Scale = originalScale end
    end
end

