-- ANTI-STUN LOGIC (NEW FEATURE)
------------------------------------------------
local function applyAntiStun()
    local char = Player.Character
    if not char or not AntiStunEnabled then return end

    -- 1. Reset Animation Speeds (Fixes "Slow Hits")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                -- If animation is artificially slowed down, force it to normal speed
                if track.Speed < 1 and track.Speed > 0 then
                    track:AdjustSpeed(1)
                end
            end
        end
    end

    -- 2. Clear Stun Attributes/Values
    -- These are the standard names used by most Roblox fighting engines
    local tags = {"Stunned", "Stun", "ActionPaused", "AttackingStun", "IsStunned"}
    for _, name in ipairs(tags) do
        if char:GetAttribute(name) then
            char:SetAttribute(name, false)
        end
        local obj = char:FindFirstChild(name)
        if obj and (obj:IsA("BoolValue") or obj:IsA("NumberValue")) then
            obj.Value = (obj:IsA("BoolValue") and false or 0)
        end
    end
end

-- Dedicated loop for Anti-Stun to ensure high-performance response
task.spawn(function()
    while true do
        task.wait()
        if AntiStunEnabled then
            pcall(applyAntiStun)
        end
    end
end)

