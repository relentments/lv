UIS.InputBegan:Connect(function(input, gpe)
    if gpe or not GlideActive then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
    local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z).Unit

    if UIS:IsKeyDown(MODIFIER_KEY) then
        if input.KeyCode == Enum.KeyCode.W then applyDash(look)
        elseif input.KeyCode == Enum.KeyCode.S then applyDash(-look)
        elseif input.KeyCode == Enum.KeyCode.A then applyDash(-right)
        elseif input.KeyCode == Enum.KeyCode.D then applyDash(right)
        end
    end

    if input.KeyCode == MODIFIER_KEY then
        local dir = getDirectionFromKeys()
        if dir then applyDash(dir) end
    end
end)

